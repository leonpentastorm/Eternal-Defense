{id:"7516F7907EB08F7F" filename:"05_beacon" title:"The Shared Defense Beacon" order_index:5 quests:[{id:"8C34BD91234FA26D" title:"Plant your beacon" description:["Read your Field Guide, then use the beacon on the ground and confirm planting. One shared team objective. First raid: after seven active Minecraft days, at night with a defender nearby. Right-click opens the control panel. Settings lets you toggle the 3D base outline. Hold the Beacon Recovery Shovel to remove it with confirmation and reset every upgrade."] icon:"arsenal_beacon:defense_beacon" x:0.0d y:0.0d  tasks:[{id:"4AB6163CB11B44CA" type:"item" item:"arsenal_beacon:defense_beacon" count:1L consume_items:false}]}
{id:"617FDF5E5023A614" title:"Industrial fortifications" description:["Use a heated Create compacting line to produce reinforced plating. The core branch needs 16, 32, 64, then 128 plating; each grade adds eight blocks of radius and 250 health. Right-click the beacon and select the core upgrade."] icon:"arsenal_beacon:reinforced_plating" x:2.0d y:0.0d dependencies: ["8C34BD91234FA26D"]
 tasks:[{id:"C99F48D77DBA15AA" type:"item" item:"arsenal_beacon:reinforced_plating" count:1L consume_items:false}]}
{id:"505E8A3A73902BE0" title:"Supply and reward ladder" description:["Automate logistics modules with sequenced assembly. Better base construction and logistics raise rewards. Actual paid reward tiers set the interval: 7, 6, 5, 4, 3, then 2 days. Victories alone never make low-tier raids more frequent."] icon:"arsenal_beacon:logistics_module" x:4.0d y:0.0d dependencies: ["617FDF5E5023A614"]
 tasks:[{id:"E1C7B47A6B08058B" type:"item" item:"arsenal_beacon:logistics_module" count:1L consume_items:false}]}
{id:"5779A579AB2E7809" title:"Automated gun defenses" description:["Unlock Precision production by operating a press, mixer and deployer and making a precision mechanism. Open the Weapon Platform Turrets category to build TaCZ turrets. Mount a gun and supply its ammunition from a chest below. Ammo remains consumed after victory repairs. Keep moving Create contraptions parked and disassembled into blocks before raids."] icon:"tacz_turrets:turret" x:6.0d y:0.0d dependencies: ["505E8A3A73902BE0"]
 tasks:[{id:"A739D2B10F77E627" type:"item" item:"tacz_turrets:turret" count:1L consume_items:false}]}
{id:"F671FB39CA9FD1AE" title:"Resonant shielding" description:["Automate heated mixing to feed the defense branch. Each grade reduces damage when attackers reach the beacon. Every three defender deaths during a raid costs ten percent of beacon health."] icon:"arsenal_beacon:resonance_coil" x:8.0d y:0.0d dependencies: ["5779A579AB2E7809"]
 tasks:[{id:"CBE8B19A1D86B80D" type:"item" item:"arsenal_beacon:resonance_coil" count:1L consume_items:false}]}
{id:"A7A7D453CC4E468D" title:"Reconnaissance network" description:["Produce 16 resonance coils and buy Reconnaissance in the Upgrades tab. Every attacker then glows immediately, through walls. Without this upgrade, surviving attackers are highlighted after one minute in each wave. The compact raid HUD shows the number still incoming or alive. Outside raids, hold the Beacon Recovery Shovel to see beacon status."] icon:"arsenal_beacon:resonance_coil" x:10.0d y:0.0d dependencies: ["F671FB39CA9FD1AE"]
 tasks:[{id:"67F026559ECB4A87" type:"item" item:"arsenal_beacon:resonance_coil" count:1L consume_items:false}]}
{id:"2398189D6FBD20F0" title:"Restoration network" description:["A 5x5 mechanical crafting array produces restoration matrices. Restoration upgrades rebuild tracked raid damage faster and heal more beacon health after victory. Surviving inventories are not rolled back; spent ammo stays spent."] icon:"arsenal_beacon:restoration_matrix" x:12.0d y:0.0d dependencies: ["A7A7D453CC4E468D"]
 tasks:[{id:"1FBEDF11E039004C" type:"item" item:"arsenal_beacon:restoration_matrix" count:1L consume_items:false}]}
{id:"E5DB3041A496C2FE" title:"High reward siege" description:["At the highest payout tier, raids stop becoming more frequent: minimum two days. Further successful defenses increase enemy strength. Wave supplies and victory rewards can be claimed at the beacon."] icon:"minecraft:totem_of_undying" x:14.0d y:0.0d dependencies: ["2398189D6FBD20F0"]
 tasks:[{id:"ADDE7C45E0BEC9F2" type:"item" item:"minecraft:totem_of_undying" count:1L consume_items:false}]}]}