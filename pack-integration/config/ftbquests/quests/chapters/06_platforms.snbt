{id:"F013B5F76D678B06" filename:"06_platforms" title:"Universal Weapon Platforms" order_index:6 quests:[{id:"0259F49AEA18F456" title:"Three universal stations" description:["Craft the Weapon Platform in JEI. Buy Ammo and Attachment tables in its Workshop; upgrade them there after placing within 8 blocks. Hold your gun and use the configured TaCZ Interact control at a component table for compatible recipes. Each station unifies every loaded gunpack in small pages. Hover material icons and use JEI recipe or uses shortcuts."] icon:"arsenal_beacon:gun_platform" x:0.0d y:0.0d  tasks:[{id:"9D988196D00614E4" type:"item" item:"arsenal_beacon:gun_platform" count:1L consume_items:false}]}
{id:"572D032B0926BF62" title:"Historical production" description:["Age 1 is Frontier. Upgrade with iron, andesite alloy, cogwheels and pressed receivers for Age 2 World Wars. These Ages require basic ores and Create machinery."] icon:"kubejs:pressed_receiver" x:2.0d y:0.0d dependencies: ["0259F49AEA18F456"]
 tasks:[{id:"06F7EA62CB7B5C9C" type:"item" item:"kubejs:pressed_receiver" count:1L consume_items:false}]}
{id:"9DE9218FD256EEEC" title:"Modern requires the Nether" description:["Each station upgrades independently. Age 3 Modern requires hardened receivers, precision mechanisms, blaze rods and brass sheets. An M4A1 or P320 stays here regardless of damage."] icon:"minecraft:blaze_rod" x:4.0d y:0.0d dependencies: ["572D032B0926BF62"]
 tasks:[{id:"39A95BFCF745D420" type:"item" item:"minecraft:blaze_rod" count:1L consume_items:false}]}
{id:"0172A7744AB11BC8" title:"Advanced engineering" description:["Age 4 adds heavy and advanced weapons. Automate hardened receivers and precision mechanisms, and supply netherite scrap and resonance coils."] icon:"minecraft:netherite_scrap" x:6.0d y:0.0d dependencies: ["9DE9218FD256EEEC"]
 tasks:[{id:"45A22B74FD54FBA1" type:"item" item:"minecraft:netherite_scrap" count:1L consume_items:false}]}
{id:"1BB5D3A59A81243E" title:"Exotic technology" description:["Age 5 unlocks gauss, cyberpunk and energy weapons. Produce exotic receivers and restoration matrices, then supply End rods and a Nether star."] icon:"kubejs:exotic_receiver" x:8.0d y:0.0d dependencies: ["0172A7744AB11BC8"]
 tasks:[{id:"EFBFE5527291D829" type:"item" item:"kubejs:exotic_receiver" count:1L consume_items:false}]}
{id:"3CD89151C7B53F4A" title:"Create Armory production" description:["Open the separate Create Armory category at the Weapon Platform. Workshop weapons require operating a press and mixer. Precision weapons also require operating a deployer and making a precision mechanism. Steam weapons additionally require operating a steam engine. These shared unlocks do not depend on station Ages. Native Create Armory materials are still required."] icon:"create:precision_mechanism" x:10.0d y:0.0d dependencies: ["1BB5D3A59A81243E"]
 tasks:[{id:"81933A5F7184010C" type:"item" item:"create:precision_mechanism" count:1L consume_items:false}]}
{id:"F511ADEC753E51B9" title:"Industrial base score" description:["Place all three inside the square beacon zone. Higher Ages give 40 / 90 / 180 / 300 / 450 score each. Only the highest Age of each type counts; duplicate stations cannot stack the bonus. Mining and replacing preserve station Ages."] icon:"arsenal_beacon:attachment_platform" x:12.0d y:0.0d dependencies: ["3CD89151C7B53F4A"]
 tasks:[{id:"7D8EFC660B98E04C" type:"item" item:"arsenal_beacon:attachment_platform" count:1L consume_items:false}]}]}