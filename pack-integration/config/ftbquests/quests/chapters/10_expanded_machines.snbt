{id:"4607C0E6302B41FD" title:"Programmable logistics" icon:"computercraft:computer_normal" x:4.0d y:0.0d description:["CC:Tweaked supplies computers and modems for programmable automation. Additional Logistics, Contraption Terminals and Tom’s Storage extend factory storage and transport. Railways Navigator and Steam ’n’ Rails help build the transport network."] tasks:[{id:"7010064DFD16F61C" type:"item" item:"computercraft:computer_normal" count:1L consume_items:false}]}]}