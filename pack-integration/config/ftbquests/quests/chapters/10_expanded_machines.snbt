{id:"E9F26502AB46D004" filename:"10_expanded_machines" title:"Expanded Machine Workshop" order_index:10 quests:[{id:"45BEA316FA5FFDED" title:"Precision foundry" icon:"createmetallurgy:foundry_basin" x:0.0d y:0.0d description:["Create Metallurgy adds molten-metal foundries, casting and processing. Use JEI and Ponder to plan the basin, mixer and casting equipment. Metalwork and Vintage add further factory machinery."] tasks:[{id:"2DFB4A7B53104C42" type:"item" item:"createmetallurgy:foundry_basin" count:1L consume_items:false}]}
