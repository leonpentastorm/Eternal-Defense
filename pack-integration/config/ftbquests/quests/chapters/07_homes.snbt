{id:"81B478FD95B33AD8" filename:"07_homes" title:"Homes and Architecture" order_index:7 quests:[{id:"E92AFDBAAFBF8810" title:"Design a home" icon:"minecraft:bricks" x:0.0d y:0.0d description:["Plan rooms, paths and rooflines around the protected zone. Chipped, Rechiseled, framed blocks and Macaw building pieces provide material and shape choices. Furniture and machinery inside the beacon zone contribute to the existing base score."] tasks:[{id:"E6CBB0EAFB690D90" type:"item" item:"minecraft:bricks" count:1L consume_items:false}]}
{id:"6AC3B5C2C26FDB33" title:"Furnish the workshop" icon:"furniture:oak_desk" x:2.0d y:0.0d description:["JEI contains furnishings from Handcrafted, Beautify, Refurbished Furniture and Furniture. Build a kitchen, study or gun room. Decorative furniture is available through ordinary recipes; our gun displays remain in Weapon Platform > Supplies."] tasks:[{id:"699A1E7B11FD6897" type:"item" item:"furniture:oak_desk" count:1L consume_items:false}]}
{id:"E982E480E53EAC8A" title:"Windows and gardens" icon:"minecraft:glass_pane" x:4.0d y:0.0d description:["Use Connected Glass and diagonal windows, walls and fences for varied layouts. Athena-based Chipped panes retain their ordinary connected models for compatibility. Vinery, Meadow and Beachparty add garden and outdoor furnishings."] tasks:[{id:"3285D6C9F157763A" type:"item" item:"minecraft:glass_pane" count:1L consume_items:false}]}]}