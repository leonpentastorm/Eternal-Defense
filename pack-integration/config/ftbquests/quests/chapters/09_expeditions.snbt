{id:"A429952C4205FF73" filename:"09_expeditions" title:"Expeditions and New Worlds" order_index:9 quests:[{id:"7E675B730A66FE5E" title:"Travel prepared" icon:"minecraft:compass" x:0.0d y:0.0d description:["Use your backpack, map and sleeping bag. Lootr chests give individual player loot. Stock ammunition and supplies before leaving. High-tier defenders can purchase a raid break for a long expedition."] tasks:[{id:"D0876ADB0503312B" type:"item" item:"minecraft:compass" count:1L consume_items:false}]}
{id:"B789890C043E061E" title:"Above the clouds" icon:"aether:book_of_lore" x:2.0d y:0.0d description:["The Aether and Deep Aether add sky islands, dungeons and equipment. Consult the Book of Lore and JEI for portal and progression guidance. New terrain appears in newly explored chunks."] tasks:[{id:"F1FC566221408578" type:"item" item:"aether:book_of_lore" count:1L consume_items:false}]}
{id:"8DCA6EE3D31DDE27" title:"Twilight expedition" icon:"twilightforest:magic_map" x:4.0d y:0.0d description:["Twilight Forest has its own exploration and boss progression. Follow its advancements instead of treating every boss as immediately accessible. Bring a map and supplies."] tasks:[{id:"49DA9BCBEB4376F1" type:"item" item:"twilightforest:magic_map" count:1L consume_items:false}]}
{id:"74A85DE9688A99F7" title:"Deep underground" icon:"minecraft:spyglass" x:6.0d y:0.0d description:["Explore Alex’s Caves, Deeper and Darker, and Blue Skies for distinct expeditions. Iron’s Spells adds a magic path alongside firearms. Keep an eye on difficulty and return with resources for the factory."] tasks:[{id:"55A73B3E5C775BFC" type:"item" item:"minecraft:spyglass" count:1L consume_items:false}]}]}