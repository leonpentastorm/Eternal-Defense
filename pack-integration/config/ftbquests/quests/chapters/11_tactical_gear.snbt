{id:"DCEF7200B00B2001" filename:"11_tactical_gear" title:"Tactical Gear Workshop" order_index:11 quests:[{id:"DCEF7200B00B2002" title:"Armor fabrication" icon:"arsenal_beacon:armor_platform" x:0.0d y:0.0d description:["Open the Weapon Platform Workshop and buy an Armor Platform. Place it nearby. It occupies two blocks wide, two tall and one deep. Open it empty-handed to browse worn armor, helmets, masks, tactical pouches, backpacks, plates and vision gear. The Type filter, Age filter and search combine to find the gear you need. JEI also shows Armor Platform fabrication recipes. Buy grenades, food, healing supplies and other field tools in the Weapon Platform Supplies category."] tasks:[{id:"DCEF7200B00B2003" type:"item" item:"arsenal_beacon:armor_platform" count:1L consume_items:false}]}
{id:"DCEF7200B00B2004" title:"Factory-made protection" icon:"arsenal_beacon:reinforced_plating" x:2.0d y:0.0d description:["Upgrade the armor bench through the Weapon Platform Workshop. Its Age is independent from gun, ammo and attachment Ages. Modern protection and NVGs require a team Nether visit and Create precision parts. Heavy and specialized equipment needs later industry. Native plates, backpacks and Curios keep their original functions: matching plate systems are mod-specific, so use their tooltips. Place the upgraded Armor Platform inside the beacon zone to earn base score; duplicate benches do not stack the bonus."] tasks:[{id:"DCEF7200B00B2005" type:"item" item:"arsenal_beacon:reinforced_plating" count:1L consume_items:false}]}]}