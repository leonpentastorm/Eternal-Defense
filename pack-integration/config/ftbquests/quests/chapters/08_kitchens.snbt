{id:"1DD15483798500E8" filename:"08_kitchens" title:"Kitchens and Food Factories" order_index:8 quests:[{id:"246BBC4C6037D669" title:"First kitchen" icon:"farmersdelight:cooking_pot" x:0.0d y:0.0d description:["Start with Farmer’s Delight: a knife, cutting board, heated cooking pot and farm. JEI shows meal recipes and ingredient alternatives. Display Delight decorates prepared meals."] tasks:[{id:"A92CF2A2F2380DED" type:"item" item:"farmersdelight:cooking_pot" count:1L consume_items:false}]}
{id:"E88A3EBDA1BE2A97" title:"A second kitchen" icon:"farm_and_charm:mincer" x:2.0d y:0.0d description:["Farm & Charm adds kitchen equipment and farming systems. Its compatible Bakery, Brewery and Candlelight editions share ingredients and cooking equipment. Vinery, HerbalBrews and Meadow extend drinks and farming."] tasks:[{id:"C857B13D0CFFC230" type:"item" item:"farm_and_charm:mincer" count:1L consume_items:false}]}
{id:"40DD9CF114937D2C" title:"Factory food" icon:"create:mechanical_mixer" x:4.0d y:0.0d description:["Use Create Food, Delightful Creators, Central Kitchen and Slice & Dice for automated preparation. Follow JEI recipe categories for mixing, cutting, heating and deploying. A belt-fed meal factory can supply every defender."] tasks:[{id:"2C440CA1907C5BCA" type:"item" item:"create:mechanical_mixer" count:1L consume_items:false}]}
{id:"6CF45DDDB92C1FCE" title:"Jam and cake line" icon:"create:spout" x:6.0d y:0.0d description:["Create Bakery adds fluid jams, filling and cake automation for Bakery and Farm & Charm. Connect mixers, heated basins, spouts and deployers. Bakery furniture provides a storefront for the finished products."] tasks:[{id:"12407A774FB6B995" type:"item" item:"create:spout" count:1L consume_items:false}]}]}